{
  "name": "vyra",
  "version": "0.1.0",
  "private": true,
  "description": "VYRA - explainable, resource-aware disaster response platform",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "cross-env VYRA_DATA_MODE=demo next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test tests/triage.test.ts tests/api.test.ts tests/ops.test.ts tests/admin.test.ts",
    "db:setup": "node scripts/setup-db.js",
    "db:seed": "node scripts/setup-db.js --seed-only",
    "db:seed:generate": "tsx scripts/generate-seed-30.mts",
    "db:seed:generate:80": "tsx scripts/generate-seed-sql.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "leaflet": "^1.9.4",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "pg": "^8.23.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}